# Model access through OpenRouter.
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id. Defaults to deepseek/deepseek-v4-pro-0813.
AGENT_MODEL=

# Read-only role the agent queries with. On Supabase, use the transaction pooler (port 6543) for
# deployments, and note the pooler's user format, uzex_agent.<project-ref>.
# postgresql://uzex_agent.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
AGENT_DATABASE_URL=

# Only for loading data with pipeline/build.py, never needed at runtime. An owner connection on
# port 5432 (Supabase direct connection or session pooler).
DATABASE_URL=
# Password build.py sets on the uzex_agent role.
AGENT_DB_PASSWORD=
